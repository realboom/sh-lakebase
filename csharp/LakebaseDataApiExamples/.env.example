# Copy to `.env` (or export these in your shell / CI secret store) and fill in.
# Nothing here is a secret in this template — do NOT commit a filled-in .env.

# ---- Required: Databricks workspace + service principal (default auth path) ----
# Workspace URL (Azure): https://adb-<workspace-id>.<n>.azuredatabricks.net
DATABRICKS_HOST=https://adb-XXXXXXXXXXXXXXXX.NN.azuredatabricks.net
# Service-principal OAuth client id. For the Entra ID / MSAL path this is the
# Entra application (client) id.
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Service-principal OAuth client secret.
#   - Default (Databricks-managed SP) path: required.
#   - Entra ID / MSAL + CyberArk path: NOT used (the secret is fetched from
#     CyberArk at runtime). See README "Alternative auth". If you go MSAL-only,
#     relax the requirement for this var in LakebaseConfig.FromEnvironment().
DATABRICKS_CLIENT_SECRET=

# ---- Lakebase target (optional; sensible defaults in code) ----
LAKEBASE_PROJECT=sh-lakebase
LAKEBASE_BRANCH=production
LAKEBASE_ENDPOINT=primary
LAKEBASE_DATABASE=apitest
# Leave blank to auto-derive at runtime (recommended). Set only to pin/override.
LAKEBASE_ENDPOINT_HOST=
LAKEBASE_WORKSPACE_ID=

# ---- Entra ID / MSAL path only (see README) ----
# Required when using the commented-out MSAL auth path.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
